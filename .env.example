# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8001

# Backend
# Docker Compose provides a local Postgres and overrides DATABASE_URL for api/worker/beat.
# For host-side scripts against that DB:
# DATABASE_URL=postgresql://sentinel:sentinel@localhost:54322/sentinel
#
# Hosted Supabase (optional): use Session pooler URI + ?sslmode=require.
# Direct db.* host may be IPv6-only; some networks also hang on pooler SSL.
DATABASE_URL=postgresql://sentinel:sentinel@localhost:54322/sentinel
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
REDIS_URL=redis://localhost:6379/0
CELERY_WORKER_CONCURRENCY=2
SCAN_CACHE_TTL_SECONDS=86400
ALLOWED_TLD=.go.ke,.gov.ke
ALLOW_TLD_BYPASS=false
GEMINI_API_KEY=
# Optional legacy (unused): ANTHROPIC_API_KEY=
FRONTEND_URL=http://localhost:3000
APP_ENV=development